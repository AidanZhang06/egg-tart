{
  "schemaVersion": 1,
  "name": "Egg Tart",
  "author": "Aidan",
  "version": "1.0.0",
  "description": "A pixel Sunny Side egg tart that wanders around and keeps itself busy.",
  "customization": {
    "petTint": false
  },
  "viewBox": {
    "x": -20,
    "y": -34,
    "width": 60,
    "height": 60
  },
  "layout": {
    "contentBox": {
      "x": -5,
      "y": -4,
      "width": 31,
      "height": 27
    },
    "marginBox": {
      "x": -10,
      "y": -9,
      "width": 40,
      "height": 32
    },
    "centerX": 10,
    "baselineY": 23,
    "visibleHeightRatio": 0.58,
    "baselineBottomRatio": 0.05
  },
  "eyeTracking": {
    "enabled": true,
    "states": [
      "idle"
    ],
    "eyeRatioX": 0.5,
    "eyeRatioY": 0.756,
    "maxOffset": 3,
    "bodyScale": 0.33,
    "shadowStretch": 0.15,
    "shadowShift": 0.3,
    "ids": {
      "eyes": "eyes-js",
      "body": "body-js",
      "shadow": "shadow-js"
    },
    "shadowOrigin": "10px 20px"
  },
  "states": {
    "idle": [
      "idle.svg"
    ],
    "roam": [
      "roam.svg"
    ],
    "thinking": [
      "thinking.svg"
    ],
    "working": [
      "working.svg"
    ],
    "juggling": [
      "juggling.svg"
    ],
    "attention": [
      "attention.svg"
    ],
    "sweeping": [
      "sweeping.svg"
    ],
    "carrying": [
      "carrying.svg"
    ],
    "sleeping": [
      "sleeping.svg"
    ],
    "waking": [
      "waking.svg"
    ],
    "error": {
      "fallbackTo": "attention"
    },
    "notification": {
      "fallbackTo": "attention"
    }
  },
  "sleepSequence": {
    "mode": "direct"
  },
  "timings": {
    "minDisplay": {
      "attention": 4800,
      "error": 5000,
      "sweeping": 5500,
      "notification": 5000,
      "carrying": 3000,
      "working": 1000,
      "thinking": 1000
    },
    "autoReturn": {
      "attention": 4800,
      "error": 5000,
      "sweeping": 300000,
      "notification": 5000,
      "carrying": 3000
    },
    "wakeDuration": 1500,
    "deepSleepTimeout": 600000,
    "mouseIdleTimeout": 20000,
    "mouseSleepTimeout": 60000
  },
  "hitBoxes": {
    "default": {
      "x": -1,
      "y": 7,
      "w": 23,
      "h": 16
    },
    "sleeping": {
      "x": -2,
      "y": 7,
      "w": 24,
      "h": 15
    },
    "wide": {
      "x": -4,
      "y": 4,
      "w": 28,
      "h": 19
    }
  },
  "sleepingHitboxFiles": [
    "sleeping.svg"
  ],
  "reactions": {
    "drag": {
      "file": "drag.svg"
    },
    "clickLeft": {
      "file": "react-left.svg",
      "duration": 2500
    },
    "clickRight": {
      "file": "react-right.svg",
      "duration": 2500
    }
  }
}
